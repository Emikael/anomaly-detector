RABBITMQ_USERNAME=anomaly
RABBITMQ_PASSWORD=anomaly
RABBITMQ_PORT=5672
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

CONSUMER_HTTP_PORT=8080
PRODUCER_HTTP_PORT=8081

DETECTOR_WINDOW_SIZE=50
DETECTOR_Z_THRESHOLD=3.0
DETECTOR_MIN_SAMPLES=30
DETECTOR_EXCLUDE_ANOMALIES=true
DETECTOR_CONSECUTIVE_OVERRIDE=5
DETECTOR_SUMMARY_EVERY=100

PRODUCER_SCHEDULING_ENABLED=true
PRODUCER_INTERVAL_MS=250
PRODUCER_MEAN=100.0
PRODUCER_STDDEV=5.0
PRODUCER_ANOMALY_PROBABILITY=0.02
PRODUCER_ANOMALY_SIGMA_MIN=8.0
PRODUCER_ANOMALY_SIGMA_MAX=12.0
PRODUCER_SEED=42
PRODUCER_LEVEL_SHIFT_ENABLED=false
PRODUCER_LEVEL_SHIFT_AT_SEQUENCE=400
PRODUCER_LEVEL_SHIFT_SIGMA=10.0

LOG_FORMAT=plain
