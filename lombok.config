# Repo root, so neither module inherits stray settings from a parent directory outside the project.
config.stopBubbling = true

# Marks generated members with @lombok.Generated, which JaCoCo excludes from coverage. Without it a
# generated constructor or getter counts as uncovered code and drags the ratio down for lines no one
# wrote or can meaningfully test.
lombok.addLombokGeneratedAnnotation = true

# Keeps @Slf4j's field on the name this codebase already uses, so adopting the annotation is a pure
# deletion of the LoggerFactory line rather than a rename rippling through every call site.
lombok.log.fieldName = LOGGER
